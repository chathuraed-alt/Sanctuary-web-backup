</main>

<script>
    (function () {
        var cards = Array.prototype.slice.call(document.querySelectorAll('[data-filter-card]'));
        var items = Array.prototype.slice.call(document.querySelectorAll('[data-project-item]'));
        var gallery = document.getElementById('project-gallery');

        if (!cards.length || !items.length || !gallery) {
            return;
        }

        function setFilter(type) {
            cards.forEach(function (card) {
                var active = card.getAttribute('data-filter-card') === type;
                card.classList.toggle('is-active', active);
                card.setAttribute('aria-pressed', active ? 'true' : 'false');
            });

            items.forEach(function (item) {
                item.hidden = item.getAttribute('data-project-type') !== type;
            });

            window.setTimeout(function () {
                gallery.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 80);
        }

        cards.forEach(function (card) {
            card.addEventListener('click', function () {
                setFilter(card.getAttribute('data-filter-card'));
            });
        });
    }());
</script>

<?php get_footer(); ?>
