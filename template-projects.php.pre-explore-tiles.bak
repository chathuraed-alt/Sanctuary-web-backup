    .sh-project-hero-collage{position:relative;right:auto;top:auto;bottom:auto;width:100%;height:440px;margin-top:16px}
    .sh-project-hero-photo{box-shadow:0 12px 28px rgba(40,47,42,.12)}
    .sh-project-hero-photo--one{left:4%;top:27%;width:46%;height:47%}
    .sh-project-hero-photo--two{right:0;top:0;width:73%;height:57%}
    .sh-project-hero-photo--three{right:7%;bottom:0;width:61%;height:49%}
}
@media (max-width:420px){
    .sh-project-hero-collage{height:410px}
    .sh-project-page .sh-project-hero-copy h1{font-size:44px}
}
</style>


