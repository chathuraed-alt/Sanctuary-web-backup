    }

    .sh-project-gallery-card:hover {
        transform: translateY(-4px);
        border-color: rgba(63, 89, 73, 0.30);
        box-shadow: 0 20px 40px rgba(36, 46, 38, 0.12);
    }

    .sh-project-gallery-card[hidden] {
        display: none !important;
    }

    .sh-project-gallery-image {
        position: relative;
        overflow: hidden;
        aspect-ratio: 1 / 0.78;
        background: #ddd4c7;
    }

    .sh-project-gallery-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.8s ease;
    }

    .sh-project-gallery-card:hover .sh-project-gallery-image img {
        transform: scale(1.06);
    }

    .sh-project-gallery-body {
        padding: 24px 24px 26px;
    }

    .sh-project-gallery-type {
        display: inline-block;
        margin-bottom: 12px;
        color: #bb8964;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
    }

    .sh-project-gallery-body h3 {
        margin: 0 0 10px;
        color: var(--sh-green);
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: 34px;
        line-height: 0.98;
        font-weight: 500;
        letter-spacing: -0.04em;
    }

    .sh-project-gallery-link {
        color: var(--sh-muted);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .sh-project-cta-shell {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
    }

    .sh-project-cta {
        --sh-global-cta-art: url("data:image/svg+xml;base64,");
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 34px;
        align-items: center;
        width: 100%;
        margin: 0 auto;
    }

    .sh-project-cta h2 {
        margin: 0 0 16px;
        color: var(--sh-green);
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(42px, 4.8vw, 74px);
        line-height: 0.94;
        font-weight: 500;
        letter-spacing: -0.05em;
    }

    .sh-project-cta p {
        margin: 0;
        color: var(--sh-muted);
        font-size: 16px;
        line-height: 1.8;
        max-width: 520px;
    }

    .sh-project-cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        justify-content: flex-start;
    }

    .sh-project-cta-actions .sh-project-btn--solid {
        background: var(--sh-green);
        color: #ffffff !important;
        border-color: var(--sh-green);
    }

    .sh-project-cta-actions .sh-project-btn--solid:hover {
        background: var(--sh-green-deep);
        border-color: var(--sh-green-deep);
    }

    .sh-project-cta-actions .sh-project-btn--ghost {
        background: transparent;
        color: var(--sh-green) !important;
        border-color: rgba(63, 89, 73, 0.38);
    }

    @media (max-width: 1199px) {
        .sh-project-type-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .sh-project-gallery-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 991px) {
        .sh-project-hero-grid {
            grid-template-columns: 1fr 1fr;
            grid-template-rows: repeat(3, 1fr);
            gap: 10px;
            padding: 10px;
        }

        .sh-project-hero-tile:nth-child(1),
        .sh-project-hero-tile:nth-child(4) {
            grid-column: auto;
            grid-row: auto;
        }

        .sh-project-hero-copy {
            width: calc(100% - 44px);
            margin-left: 22px;
            padding-top: 154px;
        }

        .sh-project-featured-card:nth-child(n) {
            grid-column: span 6;
            min-height: 340px;
        }

        .sh-project-cta {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 767px) {
        .sh-project-page {
            margin-bottom: 74px;
        }

        .sh-project-shell {
            width: calc(100% - 28px);
        }

        .sh-project-section {
            margin-bottom: 72px;
        }

        .sh-project-hero {
            min-height: 640px;
            margin-bottom: 74px;
        }

        .sh-project-hero-copy h1 {
            font-size: 58px;
        }

        .sh-project-type-grid,
        .sh-project-gallery-grid,
        .sh-project-featured-grid {
            grid-template-columns: 1fr;
        }

        .sh-project-featured-card:nth-child(n) {
            grid-column: auto;
            min-height: 320px;
        }

        .sh-project-type-card {
            padding: 22px 20px;
        }
    }
</style>
<style id="sh-project-hero-collage-v1">
