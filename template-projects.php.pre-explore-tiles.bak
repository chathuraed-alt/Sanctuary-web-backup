}
.sh-project-page .sh-project-hero-copy h1{
    max-width:430px;
    margin:0 0 22px;
    color:#3f5949;
    font-family:"Italiana","Cormorant Garamond",Georgia,serif;
    font-size:clamp(54px,5.15vw,76px);
    font-weight:400;
    letter-spacing:-.035em;
    line-height:.98;
}
.sh-project-page .sh-project-hero-copy p{
    max-width:390px;
    margin:0 0 30px;
    color:#59635d;
    font-size:clamp(15px,1.1vw,17px);
    line-height:1.65;
}
.sh-project-page .sh-project-hero-actions{display:flex;gap:0}
.sh-project-page .sh-project-hero .sh-project-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:50px!important;
    height:auto!important;
    padding:15px 27px!important;
    border-radius:999px!important;
    font-size:11px;
    font-weight:700;
    letter-spacing:.16em;
}
.sh-project-page .sh-project-hero .sh-project-btn--solid{
    border:1px solid #3f5949;
    background:#3f5949;
    color:#fff!important;
}
.sh-project-page .sh-project-hero .sh-project-btn--solid:hover,
.sh-project-page .sh-project-hero .sh-project-btn--solid:focus-visible{
    background:#55715b;
    border-color:#55715b;
    color:#fff!important;
    outline:2px solid rgba(63,89,73,.36);
    outline-offset:3px;
}
.sh-project-hero-collage{
    position:absolute;
    right:clamp(22px,4.4vw,72px);
    top:clamp(188px,21vh,205px);
    bottom:clamp(34px,5vh,58px);
    width:min(59vw,860px);
    z-index:3;
}
.sh-project-hero-photo{
    position:absolute;
    margin:0;
    overflow:hidden;
    border-radius:var(--sh-radius-lg);
    background:#eee8df;
    box-shadow:0 18px 42px rgba(40,47,42,.13);
}
.sh-project-hero-photo img{
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
}
.sh-project-hero-photo--one{left:0;top:17%;width:39%;height:60%;z-index:3}
.sh-project-hero-photo--one img{object-position:52% 50%}
.sh-project-hero-photo--two{right:0;top:0;width:66%;height:64%;z-index:1}
.sh-project-hero-photo--two img{object-position:center 48%}
.sh-project-hero-photo--three{right:7%;bottom:0;width:49%;height:47%;z-index:4}
.sh-project-hero-photo--three img{object-position:center 52%}
@media (max-width:1100px) and (min-width:768px){
    .sh-project-hero-panel{width:46%}
    .sh-project-page .sh-project-hero-copy{padding-left:42px!important;padding-right:58px!important}
    .sh-project-page .sh-project-hero-copy h1{font-size:58px}
    .sh-project-hero-collage{right:24px;width:58vw}
}
@media (max-width:767px){
    .sh-project-page .sh-project-hero{min-height:0;margin-bottom:72px;padding-top:154px;overflow:hidden}
    .sh-project-hero-panel{position:relative;left:auto;top:auto;bottom:auto;width:calc(100% - 28px);margin:0 14px;display:block}
